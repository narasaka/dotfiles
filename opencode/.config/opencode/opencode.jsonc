{
  "plugin": [
    // "oh-my-openagent@file:/home/narasaka/prog/fun/oss/oh-my-openagent"
    // "oh-my-openagent@latest" // <- resolves ONCE then freezes; bump the pin below to update
    "oh-my-openagent@4.19.3"
  ],
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "Autistic",
  "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
  "agent": {
    "plan": {
      "model": "openai/gpt-5.5"
    },
    "build": {
      "model": "amazon-bedrock/us.anthropic.claude-opus-4-8",
      "variant": "max"
    }
  },
  "provider": {
    "amazon-bedrock": {
      "options": {
        "region": "us-east-2"
      },
      "models": {
        "openai.gpt-5.5": {
          "provider": {
            "npm": "@ai-sdk/amazon-bedrock/mantle",
            "api": "https://bedrock-mantle.us-east-2.api.aws/openai/v1"
          }
        }
      }
    }
  },
  "autoupdate": true,
  "mcp": {
    "linear": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp",
        "--header",
        "Authorization: Bearer ${LINEAR_API_KEY}"
      ],
      "enabled": false
    },
    "mgrep": {
      "type": "local",
      "command": [
        "mgrep",
        "mcp",
        "--store",
        "nate-mac"
      ],
      "enabled": false
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.us5.datadoghq.com/api/unstable/mcp-server/mcp",
      "headers": {
        "DD_API_KEY": "${DD_API_KEY}",
        "DD_APPLICATION_KEY": "${DD_APPLICATION_KEY}"
      },
      "enabled": false
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp",
      "oauth": {},
      "enabled": false
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-bindings": {
      "type": "remote",
      "url": "https://bindings.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-builds": {
      "type": "remote",
      "url": "https://builds.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    },
    "cloudflare-observability": {
      "type": "remote",
      "url": "https://observability.mcp.cloudflare.com/mcp",
      "enabled": true,
      "oauth": {}
    }
  }
}
